@page
@using Server.Services.DataService
@inject TenantBaseAppDbContext context
@inject IHttpContextAccessor httpContextAccessor
@{
}

<html>
<head>

</head>
<body>
<div>
        Related Tenant: @context.Tenant
    <ul>
        @foreach(var item in context.Products)
        {
            <li>@item.Id @item.Name @item.Tenant</li>
        }
        </ul>
    </div>
    <ul>
        @foreach(var item in httpContextAccessor.HttpContext.Request.Headers)
        {
            <li>@item.Key - @item.Value</li>
        }
    </ul>
</body>
</html>